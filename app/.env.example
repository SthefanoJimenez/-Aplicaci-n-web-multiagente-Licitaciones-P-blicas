# ==============================================================================
# Configuración de LicitaFácil (copiar a .env para desarrollo local)
# ==============================================================================

# Clave de API de Google Gemini (Obligatoria para el Agente Clasificador - HU-001)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini a utilizar (por defecto: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Clave secreta para firmar la sesión de Flask (cambiar en producción)
SECRET_KEY=solo-para-desarrollo-local

# Opcional: base separada para las cuentas de HU-008 durante las pruebas locales.
# Si queda vacía, comparte DATABASE_URL. Sin ambas variables, usa SQLite en app/instance.
# ACCOUNTS_DATABASE_URL=sqlite:///app/instance/cuentas.sqlite3

# ==============================================================================
# Observabilidad y Monitoreo con LangSmith (Opcional en local, recomendado en prod)
# ==============================================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=tu_api_key_de_langsmith_aqui
LANGSMITH_PROJECT=licitafacil-prod
